---
import {records,renderPortfolio} from '../lib/portfolio';
export async function getStaticPaths(){const all=await records();return all.filter(p=>p.url!=='/404.html').flatMap(page=>[{params:{path:page.url.replace(/^\/|\/$/g,'')||undefined},props:{page,all}},...(page.redirect_from||[]).filter(url=>!url.endsWith('.html')).map(url=>({params:{path:url.replace(/^\/|\/$/g,'')},props:{page,all,redirect:page.url}}))]);}
const {page,all,redirect}=Astro.props;
const html=redirect?`<!doctype html><html lang="en"><head><meta charset="utf-8"><meta http-equiv="refresh" content="0;url=${redirect}"><link rel="canonical" href="${new URL(redirect,Astro.site)}"><title>Moved</title></head><body><a href="${redirect}">Continue</a></body></html>`:await renderPortfolio(page,all);
---
<Fragment set:html={html}/>
