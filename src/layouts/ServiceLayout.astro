---
import '../../assets/css/text-compare.css';
import '../../assets/css/services.css';
interface Props { title: string; description: string; tagline: string; category: string; }
const { title, description, tagline, category } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Unsupervised Lab</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try { const theme = localStorage.getItem('theme'); if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to tool</a>
    <header class="tool-header">
      <div class="tool-header-inner">
        <div class="tool-breadcrumbs">
          <a class="tool-brand" href="/lab/"><span class="brand-mark" aria-hidden="true">[ / ]</span><span class="brand-name">Anwar Zahid <small>Unsupervised Lab</small></span></a>
          <span class="breadcrumb-separator" aria-hidden="true">/</span>
          <span class="breadcrumb-current">{title}</span>
        </div>
        <nav aria-label="Tool navigation">
          <span class="privacy-pill" title="Runs strictly inside your local browser runtime"><span class="privacy-dot" aria-hidden="true"></span> 100% In-Browser</span>
          <a href="/lab/#services" class="back-link">All tools</a>
          <button id="tool-theme" type="button" aria-label="Use dark theme" aria-pressed="false">Dark mode</button>
        </nav>
      </div>
    </header>
    <main id="main">
      <div class="tool-intro">
        <div class="tool-intro-text">
          <div class="eyebrow-wrap">
            <span class="category-pill">{category}</span>
            <span class="local-pill">Local Runtime</span>
          </div>
          <h1>{title}<span>.</span></h1>
          <p class="tool-tagline">{tagline}</p>
        </div>
        <div class="tool-meta-card" aria-label="Tool specifications">
          <div class="meta-item"><span class="meta-label">Storage</span><strong class="meta-value">Zero Uploads</strong></div>
          <div class="meta-item"><span class="meta-label">Processing</span><strong class="meta-value">Client-Side</strong></div>
          <div class="meta-item"><span class="meta-label">Access</span><strong class="meta-value">Free · No Account</strong></div>
        </div>
      </div>
      <slot />
      <noscript>This tool needs JavaScript to process your files locally in your browser.</noscript>
    </main>
    <footer class="tool-footer">
      <div class="footer-wrap">
        <p>Built by <a href="/">Anwar Zahid</a> · Part of <a href="/lab/">Unsupervised Lab</a>.</p>
        <p class="footer-note">All processing occurs strictly in your local browser runtime. Zero tracking, zero storage.</p>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#tool-theme');
      const media = window.matchMedia('(prefers-color-scheme: dark)');
      function syncTheme() {
        const dark = (document.documentElement.dataset.theme || (media.matches ? 'dark' : 'light')) === 'dark';
        toggle?.setAttribute('aria-pressed', String(dark));
        toggle?.setAttribute('aria-label', dark ? 'Use light theme' : 'Use dark theme');
        if(toggle) toggle.textContent = dark ? 'Light mode' : 'Dark mode';
      }
      toggle?.addEventListener('click', () => {
        const next = toggle.getAttribute('aria-pressed') === 'true' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        syncTheme();
      });
      media.addEventListener('change', syncTheme);
      syncTheme();
    </script>
  </body>
</html>
