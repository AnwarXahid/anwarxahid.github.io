---
import {records,renderPortfolio,localizeUrl} from '../lib/portfolio';
import {localeCodes,defaultLocale} from '../i18n/locales';
export async function getStaticPaths(){const all=await records();const pathOf=(url:string)=>url.replace(/^\/|\/$/g,'')||undefined;return all.filter(p=>p.url!=='/404.html').flatMap(page=>[...localeCodes.map(locale=>({params:{path:pathOf(localizeUrl(page.url,locale))},props:{page,all,locale,redirect:undefined as string|undefined}})),...(page.redirect_from||[]).filter(url=>!url.endsWith('.html')).map(url=>({params:{path:pathOf(url)},props:{page,all,locale:defaultLocale,redirect:page.url}}))]);}
const {page,all,locale,redirect}=Astro.props;
const html=redirect?`<!doctype html><html lang="en"><head><meta charset="utf-8"><meta http-equiv="refresh" content="0;url=${redirect}"><link rel="canonical" href="${new URL(redirect,Astro.site)}"><title>Moved</title></head><body><a href="${redirect}">Continue</a></body></html>`:await renderPortfolio(page,all,locale);
---
<Fragment set:html={html}/>
